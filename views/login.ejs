<!DOCTYPE html>
<html lang="en" data-theme="cyberpunk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-container-box {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      position: relative;
    }
    .login-chassis-card {
      width: 100%;
      max-width: 440px;
      background: var(--glass-bg);
      border: 2px solid var(--color-neon-pink);
      box-shadow: var(--accent-glow);
      border-radius: var(--panel-radius);
      padding: 3rem 2.5rem;
      backdrop-filter: blur(15px);
      display: flex;
      flex-direction: column;
      gap: 2rem;
      animation: chat-entry 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    .login-head {
      text-align: center;
    }
    .login-logo {
      font-family: var(--font-cyber);
      font-size: 1.8rem;
      font-weight: 900;
      color: var(--color-neon-cyan);
      text-shadow: var(--cyan-glow);
      margin-bottom: 0.5rem;
    }
    .login-status-alert {
      background-color: rgba(255, 0, 127, 0.1);
      border: 1px solid var(--color-neon-pink);
      color: var(--color-neon-pink);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 0.6rem;
      border-radius: 4px;
      display: none;
    }
  </style>
</head>
<body>

  <!-- scanline effects -->
  <div class="scanline-overlay"></div>

  <!-- Header nav -->
  <%- include('partials/header') %>

  <!-- Main chamber -->
  <main class="login-container-box">
    
    <div class="login-chassis-card">
      <div class="login-head">
        <h2 class="login-logo">CON_CORE LOGIN</h2>
        <p style="color: var(--text-muted); font-size: 0.85rem;">Input systems credentials keys to decrypt active administrative privileges.</p>
      </div>

      <!-- Warning overlay alerts -->
      <div class="login-status-alert" id="auth-alert-message">
        SYSTEM CORE ERROR: credentials invalid.
      </div>

      <!-- Login Form inputs -->
      <form class="contact-form" id="mainframe-login-form">
        <div class="form-field-unit">
          <label for="username">IDENTITY CALLSIGN</label>
          <input type="text" id="username" class="form-input" placeholder="Callsign node" required autocomplete="username">
        </div>
        
        <div class="form-field-unit">
          <label for="password">SECURITY PASSWORD KEY</label>
          <input type="password" id="password" class="form-input" placeholder="••••••••••••••" required autocomplete="current-password">
        </div>

        <button type="submit" class="cyber-btn" style="width:100%; margin-top:0.8rem;" id="btn-login-submit">
          <span>DECRYPT CREDENTIALS</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
          </svg>
        </button>
      </form>
    </div>

  </main>

  <!-- Footer states -->
  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    // AJAX login routing
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('mainframe-login-form');
      const alertBox = document.getElementById('auth-alert-message');
      const btn = document.getElementById('btn-login-submit');

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          alertBox.style.display = 'none';
          btn.disabled = true;
          btn.querySelector('span').innerText = 'DECRYPTING CORES...';

          const payload = {
            username: document.getElementById('username').value,
            password: document.getElementById('password').value
          };

          try {
            const res = await fetch('/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
              alert(data.message);
              window.location.href = '/admin';
            } else {
              alertBox.style.display = 'block';
              alertBox.innerText = `DECRYPTION ERROR: ${data.message}`;
            }
          } catch (err) {
            alertBox.style.display = 'block';
            alertBox.innerText = 'EXCEPTION ERROR: main authentication route offline.';
          } finally {
            btn.disabled = false;
            btn.querySelector('span').innerText = 'DECRYPT CREDENTIALS';
          }
        });
      }
    });
  </script>
</body>
</html>
