  <!-- 7. Footer systems state panel -->
  <%- include('partials/footer') %>

  <!-- Canvas particles overlays backdrops -->
  <script src="/js/main.js"></script>
  <script src="/js/chatbot.js"></script>
  <script src="/js/terminal.js"></script>
  
  <script>
    // ------------------------------------------
    // HERO PARALLAX TILT AND TYPING SCRIPT
    // ------------------------------------------
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Hero visual typing effects
      const target = document.getElementById('hero-typing-target');
      const terms = [
        "Backend Developer.",
        "Express.js & Node.js Developer.",
        "MongoDB Data Architect.",
        "Secure APIs Engineer."
      ];
      let tIdx = 0;
      let charIdx = 0;
      let isDeleting = false;
      
      function typeLoop() {
        const word = terms[tIdx];
        if (isDeleting) {
          target.innerText = word.substring(0, charIdx - 1);
          charIdx--;
        } else {
          target.innerText = word.substring(0, charIdx + 1);
          charIdx++;
        }
        
        let typeSpeed = isDeleting ? 40 : 80;
        
        if (!isDeleting && charIdx === word.length) {
          typeSpeed = 1500; // Pause at end of word
          isDeleting = true;
        } else if (isDeleting && charIdx === 0) {
          isDeleting = false;
          tIdx = (tIdx + 1) % terms.length;
          typeSpeed = 400; // Brief pause before typing next
        }
        
        setTimeout(typeLoop, typeSpeed);
      }
      if (target) typeLoop();

      // 2. Resume download trigger simulated achievement
      const resumeBtn = document.getElementById('btn-download-resume');
      if (resumeBtn) {
        resumeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          alert('Downloading Gaurvit Tiwati\'s technical resume.pdf... Data link synced!');
          
          if (window.unlockAchievement) {
            window.unlockAchievement('Credentials Downloaded', 'Downloaded Gaurvit\'s technical resume dossier.', 'badge_resume', 'Common');
          }
        });
      }

      // 3. Contact Form Submission
      const contactForm = document.getElementById('cyber-contact-form');
      if (contactForm) {
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('btn-submit-contact');
          btn.disabled = true;
          btn.innerText = 'DISPATCHING PAYLOAD...';
          
          const payload = {
            name: document.getElementById('contact-name').value,
            email: document.getElementById('contact-email').value,
            subject: document.getElementById('contact-subject').value,
            message: document.getElementById('contact-message').value
          };
          
          try {
            const res = await fetch('/api/contacts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const data = await res.json();
            
            if (data.success) {
              alert(data.message);
              contactForm.reset();
              
              // Unlock legendary contact achievement!
              if (window.unlockAchievement) {
                window.unlockAchievement('Pinged Mainframe', 'Successfully sent contact data payload to Gaurvit Tiwati.', 'badge_contact_ping', 'Rare');
              }
            } else {
              alert('Grid alert: transport failed.');
            }
          } catch (err) {
            alert('Core alert: database link offline.');
          } finally {
            btn.disabled = false;
            btn.innerText = 'DISPATCH DATA PACKET';
          }
        });
      }

      // 4. Projects filter logic
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');
      
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          const filter = btn.getAttribute('data-filter');
          
          cards.forEach(card => {
            const tags = JSON.parse(card.getAttribute('data-tags') || '[]');
            if (filter === 'all' || tags.includes(filter)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // 5. Unlocks client visual states for unlocked achievements
      async function updateClientBadges() {
        try {
          const response = await fetch('/api/achievements');
          const res = await response.json();
          if (res.success && res.data.length > 0) {
            res.data.forEach(ach => {
              const el = document.getElementById(`${ach.badgeId}-card`);
              if (el) {
                el.classList.remove('locked');
              }
            });
          }
        } catch (e) {}
      }
      setInterval(updateClientBadges, 2000); // Check unlocks periodically
    });
  </script>

  <!-- 3D Card tilt dynamic effects on Hero Image card -->
  <script>
    const chassis = document.getElementById('hero-tilt-chassis');
    const card = document.getElementById('hero-card-element');
    
    if (chassis && card) {
      chassis.addEventListener('mousemove', (e) => {
        const rect = chassis.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width/2;
        const y = e.clientY - rect.top - rect.height/2;
        
        // Tilt calculations
        const tiltX = (y / rect.height) * -20;
        const tiltY = (x / rect.width) * 20;
        
        card.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale(1.03)`;
      });
      
      chassis.addEventListener('mouseleave', () => {
        card.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
      });
    }
  </script>

</body>
</html>
